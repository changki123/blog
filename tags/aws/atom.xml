&lt;&#x2F;span&gt;&lt;span&gt;    cloudfront_signer = &lt;&#x2F;span&gt;&lt;span style=&quot;color:#bf616a;&quot;&gt;CloudFrontSigner&lt;&#x2F;span&gt;&lt;span&gt;(key_pair_id, rsa_signer)
