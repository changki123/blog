&lt;&#x2F;span&gt;&lt;span&gt;        &lt;&#x2F;span&gt;&lt;span style=&quot;color:#b48ead;&quot;&gt;return &lt;&#x2F;span&gt;&lt;span&gt;private_key.&lt;&#x2F;span&gt;&lt;span style=&quot;color:#bf616a;&quot;&gt;sign&lt;&#x2F;span&gt;&lt;span&gt;(message, padding.&lt;&#x2F;span&gt;&lt;span style=&quot;color:#bf616a;&quot;&gt;PKCS1v15&lt;&#x2F;span&gt;&lt;span&gt;(), hashes.&lt;&#x2F;span&gt;&lt;span style=&quot;color:#bf616a;&quot;&gt;SHA1&lt;&#x2F;span&gt;&lt;span&gt;())
