&lt;&#x2F;span&gt;&lt;span&gt;git remote add origin https:&#x2F;&#x2F;&lt;&#x2F;span&gt;&lt;span style=&quot;color:#96b5b4;&quot;&gt;github.com&lt;&#x2F;span&gt;&lt;span&gt;&#x2F;changki123&#x2F;blog.git
&lt;&#x2F;span&gt;&lt;span&gt;git push -u origin main
