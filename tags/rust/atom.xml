        <updated>2026-04-20T00:00:00+00:00</updated>
        
        <author>
          <name>
            
              Unknown
            
          </name>
        </author>
        
        <link rel="alternate" type="text/html" href="https://blog.changki123.click/260420-01-leetcode-1768/"/>
        <id>https://blog.changki123.click/260420-01-leetcode-1768/</id>
        
        <summary type="html">&lt;h2 id=&quot;munje&quot;&gt;문제&lt;&#x2F;h2&gt;
&lt;p&gt;&lt;a href=&quot;https:&#x2F;&#x2F;leetcode.com&#x2F;problems&#x2F;merge-strings-alternately&#x2F;&quot;&gt;1768. Merge Strings Alternately&lt;&#x2F;a&gt;&lt;&#x2F;p&gt;
&lt;p&gt;두 문자열 &lt;code&gt;word1&lt;&#x2F;code&gt;과 &lt;code&gt;word2&lt;&#x2F;code&gt;가 주어졌을 때, 두 문자열을 번갈아가며 합친 결과를 반환하는 문제다.&lt;br &#x2F;&gt;
&lt;code&gt;word1&lt;&#x2F;code&gt;부터 시작해서 한 글자씩 번갈아 추가하고, 한쪽이 먼저 끝나면 나머지 문자열을 그냥 뒤에 붙이면 된다.&lt;&#x2F;p&gt;
&lt;p&gt;&lt;strong&gt;예시:&lt;&#x2F;strong&gt;&lt;&#x2F;p&gt;
&lt;pre&gt;&lt;code&gt;word1 = &amp;quot;abc&amp;quot;, word2 = &amp;quot;pqr&amp;quot; → &amp;quot;apbqcr&amp;quot;
word1 = &amp;quot;ab&amp;quot;,  word2 = &amp;quot;pqrs&amp;quot; → &amp;quot;apbqrs&amp;quot;
word1 = &amp;quot;abcd&amp;quot;, word2 = &amp;quot;pq&amp;quot;  → &amp;quot;apbqcd&amp;quot;
&lt;&#x2F;code&gt;&lt;&#x2F;pre&gt;</summary>
        
